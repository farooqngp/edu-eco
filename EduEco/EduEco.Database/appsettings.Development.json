{
  "ConnectionStrings": {
    "EduEco": "Server=localhost,14333;Database=EduEco;User Id=sa;Encrypt=True;TrustServerCertificate=True"
  },
  "Seed": {
    "Clients": {
      "eduEco-bff": {
        "DisplayName": "EduEco Web (BFF)",
        "ClientType": "confidential",
        "ApplicationType": "web",
        "PublicKeyCertificatePath": "../../certs/bff-client.cer",
        "RequirePushedAuthorizationRequests": true,
        "BackchannelLogoutUri": "https://localhost:7100/bff/backchannel-logout",
        "GrantTypes": [ "authorization_code", "refresh_token" ],
        "Scopes": [ "openid", "profile", "email", "offline_access", "api.read", "api.write" ],
        "RedirectUris": [ "https://localhost:7100/signin-oidc" ],
        "PostLogoutRedirectUris": [ "https://localhost:7100/signout-callback-oidc" ]
      },
      "eduEco-mobile": {
        "DisplayName": "EduEco Mobile",
        "ClientType": "public",
        "ApplicationType": "native",
        "RequireDPoP": true,
        "GrantTypes": [ "authorization_code", "refresh_token" ],
        "Scopes": [ "openid", "profile", "email", "offline_access", "api.read", "api.write" ],
        "RedirectUris": [ "com.eduEco.mobile:/oauth2redirect" ],
        "PostLogoutRedirectUris": [ "com.eduEco.mobile:/oauth2logout" ]
      },
      "eduEco-api-docs": {
        "DisplayName": "EduEco API reference (Scalar, Development)",
        "ClientType": "public",
        "ApplicationType": "web",
        "GrantTypes": [ "authorization_code" ],
        "Scopes": [ "openid", "api.read", "api.write" ],
        "RedirectUris": [ "https://localhost:7037/scalar", "https://localhost:7037/scalar/" ]
      },
      "eduEco-api": {
        "DisplayName": "EduEco API (introspection, token exchange)",
        "ClientType": "confidential",
        "ApplicationType": "web",
        "PublicKeyCertificatePath": "../../certs/api-client.cer",
        "AllowIntrospection": true,
        "GrantTypes": [ "urn:ietf:params:oauth:grant-type:token-exchange" ],
        "Scopes": [ "reporting.read" ],
        "Resources": [ "eduEco-reporting" ]
      },
      "eduEco-svc-dev": {
        "DisplayName": "EduEco Dev Service Client",
        "ClientType": "confidential",
        "ApplicationType": "web",
        "PublicKeyCertificatePath": "../../certs/svc-dev-client.cer",
        "GrantTypes": [ "client_credentials" ],
        "Scopes": [ "api.read", "api.sync" ],
        "TenantCode": "demo-school"
      }
    }
  }
}
