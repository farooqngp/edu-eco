<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository package sources. <clear/> ignores machine-level feeds so local, Docker and CI builds resolve
  packages from the same place. Source mapping makes every package id come from nuget.org only
  (dependency-confusion protection; required with Central Package Management, NU1507).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
