<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"] · EduEco</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="brand">
        <a href="/">EduEco</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav>
                <a asp-page="/Account/Manage/Index">Security</a>
                <a href="/connect/endsession">Sign out</a>
            </nav>
        }
    </header>
    <main class="card">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
