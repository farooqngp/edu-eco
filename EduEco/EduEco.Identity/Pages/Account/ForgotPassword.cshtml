@page
@model EduEco.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<h1>Forgot your password?</h1>

@if (Model.Submitted)
{
    <p class="status">If an account with a confirmed email address exists, a reset link has been sent. The link is valid for 30 minutes.</p>
}
else
{
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" autofocus />
        <button type="submit">Send reset link</button>
    </form>
}

<p><a asp-page="./Login">Back to sign in</a></p>
