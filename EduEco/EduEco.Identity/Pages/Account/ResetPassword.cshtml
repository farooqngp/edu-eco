@page
@model EduEco.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<h1>Choose a new password</h1>

@if (Model.Completed)
{
    <p class="status">Your password has been reset. All existing sessions have been signed out.</p>
    <a class="button" asp-page="./Login">Sign in</a>
}
else
{
    <form method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <input type="hidden" name="userId" value="@Model.UserId" />
        <input type="hidden" name="code" value="@Model.Code" />
        <label for="password">New password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" autofocus />
        <label for="confirmPassword">Confirm new password</label>
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" />
        <button type="submit">Reset password</button>
    </form>
}
