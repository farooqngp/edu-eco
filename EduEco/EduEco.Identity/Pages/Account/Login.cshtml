@page
@model EduEco.Identity.Pages.Account.LoginModel
@inject Microsoft.Extensions.Options.IOptions<EduEco.Identity.Configuration.IdentityServerOptions> ServerOptions
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>

<form method="post" asp-route-returnUrl="@Model.ReturnUrl" novalidate>
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" type="email" autocomplete="username webauthn" autofocus />
    <span asp-validation-for="Input.Email"></span>

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" />
    <span asp-validation-for="Input.Password"></span>

    <button type="submit">Sign in</button>
</form>

<div class="divider"></div>

<form method="post" asp-page-handler="Passkey" asp-route-returnUrl="@Model.ReturnUrl">
    <input type="hidden" name="credentialJson" />
    <p class="error" data-passkey-error hidden></p>
    <button type="button" class="secondary"
            data-passkey-login
            data-options-url="@Url.Page("/Account/Login", "PasskeyOptions")">
        Sign in with a passkey
    </button>
</form>

<p><a asp-page="./ForgotPassword">Forgot your password?</a> · <a asp-page="./ResendEmailConfirmation">Resend email confirmation</a></p>
@if (ServerOptions.Value.AllowSelfRegistration)
{
    <p>New to EduEco? <a asp-page="./Register">Create an account</a></p>
}

@section Scripts {
    <script src="~/js/passkeys.js" asp-append-version="true"></script>
}
