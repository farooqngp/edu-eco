@page
@model EduEco.Identity.Pages.Account.ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Confirm email";
}

<h1>Resend confirmation link</h1>

@if (Model.Submitted)
{
    <p class="status">If an unconfirmed account with that email exists, a new confirmation link has been sent.</p>
}
else
{
    <form method="post" novalidate>
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" autofocus />
        <button type="submit">Send link</button>
    </form>
}
