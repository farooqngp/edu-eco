@page
@model EduEco.Identity.Pages.Account.SelectTenantModel
@{
    ViewData["Title"] = "Choose a school";
}

<h1>Choose a school or district</h1>

@if (Model.IsPlatformAdmin)
{
    <form method="get">
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <label for="search">Search tenants</label>
        <input id="search" name="search" type="search" value="@Model.Search" />
        <button type="submit" class="secondary">Search</button>
    </form>
}

<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    @if (Model.Tenants.Count == 0)
    {
        <p>No tenants available.</p>
    }
    else
    {
        <ul class="plain">
            @foreach (var tenant in Model.Tenants)
            {
                <li>
                    <span>@tenant.Name <small>(@tenant.Code)</small></span>
                    <button type="submit" name="tenantCode" value="@tenant.Code">Continue</button>
                </li>
            }
        </ul>
    }
</form>
