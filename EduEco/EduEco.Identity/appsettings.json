{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "OpenIddict": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EduEco": ""
  },
  "IdentityServer": {
    "Issuer": "",
    "CredentialMode": "Certificate",
    "SigningCertificates": [],
    "EncryptionCertificates": [],
    "DataProtectionKeysPath": "",
    "RequireHttps": true,
    "KnownProxies": [],
    "AccessTokenLifetime": "00:10:00",
    "IdentityTokenLifetime": "00:10:00",
    "AuthorizationCodeLifetime": "00:02:00",
    "RefreshTokenLifetime": "14.00:00:00",
    "RefreshTokenAbsoluteLifetime": "30.00:00:00",
    "RefreshTokenReuseLeeway": "00:00:00",
    "SessionLifetime": "08:00:00",
    "TokenPruningEnabled": true,
    "TokenPruningInterval": "01:00:00",
    "RateLimits": {
      "TokenPermitsPerMinute": 60,
      "LoginPermitsPerMinute": 10
    }
  }
}
