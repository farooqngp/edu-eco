<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Central Package Management: every .csproj's <PackageReference> omits Version; the
    pinned version lives in exactly one place, here. Intentionally empty for now — no
    package has been referenced anywhere in the repo yet (Phase 2, BuildingBlocks, is the
    first phase that will). When a phase adds the first reference to a new package, add its
    <PackageVersion> entry here in that same PR — do not pre-declare versions speculatively
    for packages nothing references yet.
  -->
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
    <PackageVersion Include="Dapper.Contrib" Version="2.0.78" />
    <PackageVersion Include="dbup-postgresql" Version="7.0.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="MassTransit" Version="9.2.1" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="9.2.1" />
    <PackageVersion Include="MediatR" Version="14.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>