<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      CA1707 (no underscores in identifiers) conflicts with the standard xUnit test-method
      naming convention (Method_Should_X_When_Y). Suppressed for every project under tests/
      only — production code under src/ still enforces it via the repo-root
      Directory.Build.props above.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
