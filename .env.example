# Copy to .env (git-ignored) and replace every value. Local development only.
MSSQL_SA_PASSWORD=<StrongPassword-min8-upper-lower-digit-symbol>
SQL_PORT=14333
DEV_USER_PASSWORD=<StrongPassword-min12-upper-lower-digit-symbol>
# Protects every development PFX in ./certs (tools/New-DevCertificates.ps1). Clients use private_key_jwt, no secrets.
IDENTITY_CERT_PASSWORD=<random-24+-chars>
